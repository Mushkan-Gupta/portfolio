# ============================================================================
# Environment Variables for "Ask about Mushkan" AI Chat Agent
# ============================================================================

# Google Gemini API Key
# 1. Get your free API key at Google AI Studio: https://aistudio.google.com/app/apikey
# 2. In Vercel: Project Settings -> Environment Variables -> Key: GEMINI_API_KEY
GEMINI_API_KEY=yAQ.Ab8RN6KVPizGr6a0EFAFR82AtPQ-vliIXJ-1zMzh5rWllnkfhQ

# Optional: Gemini model override (defaults to gemini-1.5-flash for fast, free-tier responses)
# Supported options: gemini-1.5-flash, gemini-2.0-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.6-flash

# Optional: Allowed Origin for CORS (e.g., https://your-portfolio.vercel.app)
# If omitted or empty, requests matching the host/domain or local development are allowed.
ALLOWED_ORIGIN=

